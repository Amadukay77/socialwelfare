 /* =========================
   OFFICIAL HEADER
========================= */

.official-header {
    background: #ffffff;
    text-align: center;
    padding: 20px;
    margin-bottom: 22px;
    border-radius: 8px;
    border: 1px solid #e5e5e5;
    border-top: 4px solid #198754;
    box-shadow: 0 3px 10px rgba(0,0,0,0.06);
}

.national-logo {
    width: 110px;
    height: auto;
    display: block;
    margin: 0 auto 10px;
    object-fit: contain;
}

.official-header h1 {
    margin: 5px 0;
    font-size: 22px;
    color: #222;
}

.official-header p {
    margin: 0;
    color: #777;
    font-size: 14px;
}